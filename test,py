def print_menu():
    print("\nAvailable Commands:")
    print("A(rm): Arm the drone, motor will spin.")
    print("D(isarm): Disarm the drone, motor will stop.")
    print("T(ake-off): Drone will auto arm and fly to 1.5m high.")
    print("L(and): Drone will land.")
    print("M(onitor): Print last known drone position and mode.")
    print("Q(uit): Exit the application.")

def main():
    # Connect to MAVLink
    # master = mavutil.mavlink_connection('/dev/ttyACM0', baud=57600)
    master = mavutil.mavlink_connection('udp:127.0.0.1:14540')

    master.wait_heartbeat()
    print("Connected to system (heartbeat received)")

    monitor = UavStateMonitor(master)
    monitor.start()

    print_welcome()

    try:
        while True:
            print_menu()
            choice = input("Enter command: ").strip().upper()

            if choice == 'A':
                print("Arming the drone... (not implemented yet)")
                monitor.arm()

            elif choice == 'D':
                print("Disarming the drone... (not implemented yet)")
                monitor.disarm()

            elif choice == 'T':
                if monitor.takeoff():
                    print("Set to TAKEOFF mode.")
                else:
                    print("Fail to set to TAKEOFF mode")

            elif choice == 'M':
                with open("waypoints.yaml") as f:
                    monitor.loaded_waypoints = yaml.safe_load(f)["waypoints"]
                monitor.current_waypoint_index = 0
                with monitor.task_lock:
                    monitor.task_state = TaskState.MISSION
                print("Set to MISSION mode.")

            elif choice == 'L':
                with monitor.task_lock:
                    monitor.task_state = TaskState.LAND
                print("Set to LAND mode.")

            elif choice == 'Q':
                print("Exiting... Goodbye!")
                break

            else:
                print("Invalid command. Please try again.")

    except KeyboardInterrupt:
        print("\nInterrupted by user. Exiting...")

    finally:
        monitor.stop()

if __name__ == "__main__":
    main()
